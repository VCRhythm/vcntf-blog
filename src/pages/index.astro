---
import { getSortedPosts } from '../lib/posts';
import Base from '../layouts/Base.astro';

const posts = await getSortedPosts();
---
<Base title="VCNTF">
  <section style="padding:48px 0 0;">
    <h1 style="font-size:28px;line-height:1.25;margin:0 0 8px;">VACANT FREQUENCY COMMUNICATION</h1>
  </section>

  <section style="padding-top:40px;">
    <h2 style="font-size:15px;font-weight:normal;color:var(--ink-soft);margin:0 0 4px;">Writing</h2>
    {posts.map((p) => (
      <article class="postrow">
        <a href={`/posts/${p.id}/`}>
          <h3>{p.data.title}</h3>
          <div class="meta">{p.data.category ?? 'Post'} · {p.data.date.toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' })}</div>
          {p.data.excerpt && <p class="excerpt">{p.data.excerpt}</p>}
        </a>
      </article>
    ))}
    {posts.length === 0 && <p style="color:var(--ink-soft);">No articles yet. Add a .md file in src/content/posts/.</p>}
  </section>
</Base>